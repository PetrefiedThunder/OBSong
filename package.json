{
  "name": "toposonics",
  "version": "0.1.0",
  "private": true,
  "description": "Turn static photos or live camera input into rich musical landscapes",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "preinstall": "node -e \"if (process.env.npm_config_user_agent && !process.env.npm_config_user_agent.includes('pnpm')) { console.error('\\n\\x1b[31m╔════════════════════════════════════════════════════════════════╗\\n║  ❌ ERROR: This project requires pnpm                         ║\\n╚════════════════════════════════════════════════════════════════╝\\x1b[0m\\n\\n\\x1b[33mPlease install pnpm:\\x1b[0m\\n  npm install -g pnpm@8.15.0\\n\\n\\x1b[33mThen run:\\x1b[0m\\n  pnpm install\\n\\n\\x1b[90mFor more info: https://pnpm.io/installation\\x1b[0m\\n'); process.exit(1); }\"",
    "dev:web": "corepack pnpm --filter @toposonics/web dev",
    "dev:mobile": "corepack pnpm --filter @toposonics/mobile dev",
    "dev:api": "corepack pnpm --filter @toposonics/api dev",
    "dev:all": "corepack pnpm -r --parallel --if-present dev",
    "build": "corepack pnpm -r --sort --if-present build",
    "build:web": "corepack pnpm --filter @toposonics/web build",
    "build:mobile": "corepack pnpm --filter @toposonics/mobile build",
    "build:mobile:android:release": "node scripts/run-android-release-build.js",
    "build:mobile:ios:release": "node scripts/run-ios-release-build.js",
    "build:api": "corepack pnpm --filter @toposonics/api build",
    "lint": "corepack pnpm -r --if-present lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "corepack pnpm -r --if-present clean && rm -rf node_modules",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:watch": "corepack pnpm --filter @toposonics/web test -- --watch",
    "release:check": "corepack pnpm release:check:env && corepack pnpm release:check:mobile",
    "release:check:env": "node scripts/check-release-env.js",
    "release:check:mobile": "node scripts/check-mobile-release.js"
  },
  "pnpm": {
    "overrides": {
      "node-forge": "1.4.0",
      "send": "^0.19.0",
      "semver": "7.7.3",
      "shell-quote": "1.12.0",
      "postcss": "8.5.31",
      "source-map-js": "1.2.2",
      "postcss-selector-parser": "7.1.6",
      "@xmldom/xmldom": "0.8.15",
      "js-yaml@4": "4.3.2",
      "ajv@6": "6.15.0",
      "minimatch@3": "3.1.5",
      "minimatch@9": "9.0.9",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@>=3": "5.0.12",
      "nanoid@3": "3.3.20",
      "ws@7": "7.5.13",
      "ws@8": "8.22.0",
      "browserslist@4": "4.29.4",
      "baseline-browser-mapping": "2.11.29",
      "compression": "1.8.2",
      "flatted": "3.4.4",
      "fast-copy@3": "3.1.0",
      "yaml@2": "2.9.1",
      "@babel/plugin-transform-modules-systemjs": "7.29.8"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0",
    "pnpm": ">=8.0.0"
  }
}

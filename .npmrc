# Force strict engine checking. Combined with the "npm": "please-use-pnpm" engines entry
# in the root package.json, this makes a bare `npm install` fail with an engine error.
engine-strict=true

# This project requires pnpm. Enforcement layers:
#   1. engines.npm = "please-use-pnpm" + engine-strict (above) blocks npm at install time;
#   2. the root "preinstall" guard checks the package-manager user agent;
#   3. the "packageManager" field + corepack pin pnpm 8.15.0.
# If you see a pnpm-required error, install pnpm: npm install -g pnpm@8.15.0

# Don't auto-install peerDependencies. @toposonics/ui declares react as a peer (the
# consuming app supplies it); auto-installing put a second React copy inside
# packages/ui/node_modules, which Metro can resolve for React Native builds — two
# Reacts in one bundle breaks hooks. Consumers declare their own React explicitly.
auto-install-peers=false
